\par 4\tab Won't gallop\tab Single rider\tab 
\par 5\tab Chews fences\tab Rears\tab 
\par 6\tab Stops occasionally\tab Headstrong\tab 
\par 7\tab Rubs against fences\tab Kicks\tab 
