\par \tab Mountain borderlands
\par \tab Settled seacoast
\par \tab Shallow ocean
\par \tab Waterfront district, Sulidam
\par \tab Nobles' district, Sulidam
\par \tab Artisan's district, Sulidam
\par \tab Slums, Sulidam
\par \tab Temple of Martens (a powerful cult of Sulidam)
\par \tab Sewers of Sulidam
\par \tab Emperor's Palace
\par \tab City of Crypts (a cemetery outside Sulidam)
\par \tab Dungeon of Theos (under an evil wizard's villa in Sulidam)
\par \tab Coralport
\par \tab Coralport jungles
\par \tab The Harpooned Whale, an inn of Coralport
\par }\pard\plain \s15\keep\nowidctlpar\tx-720\tx270\adjustright {\tab Hargast Mine (an opening to the Underdark)
