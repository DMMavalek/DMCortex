\par }\pard\plain \keep\nowidctlpar\tx-720\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\adjustright \fs20 {\fs24 01-50\tab  \emdash \tab 26\tab 26\tab 26\tab \emdash \tab \emdash \tab 
\par 51-90\tab  26\tab \emdash \tab 26\tab \emdash \tab 26\tab \emdash \tab 
