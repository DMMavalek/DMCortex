\par }{\fs24 \tab }{\b\fs24  }{\fs24 
\par }\pard \keep\nowidctlpar\tx-720\tx1440\tx3690\adjustright {\b\fs24 Plaque\tab Playing Card\tab Effect}{\fs24 
