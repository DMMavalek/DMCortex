\par }\pard \nowidctlpar\tx360\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright {\fs24 Bow bonus\tab Secret doors
\par Infravision, 60'\tab Stealth
\par Resistance\tab Sword bonus
\par 
