\par }\pard \qc\nowidctlpar\tx720\tx1440\tx2160\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\adjustright {\fs36\cf6 Chapter 6:
\par Magic
