\par }{\fs28\cf6 Purchasing Components
\par }{\fs24 
\par }\pard \keep\nowidctlpar\tx1440\tx3150\tx5040\tx5760\tx6480\tx7200\tx7920\adjustright {\b\fs24 City\tab \emdash \emdash \emdash \emdash \emdash \emdash \emdash Scarcity\emdash \emdash \emdash \emdash \emdash \emdash \emdash 
\par Size\tab Common\tab Uncommon\tab Rare
\par }{\fs24 Village\tab 80%\tab 50%\tab 20%
