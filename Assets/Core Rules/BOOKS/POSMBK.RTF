\par }\pard \keep\nowidctlpar\tx2880\tx3600\tx4320\tx5040\tx5760\tx6480\tx7200\tx7920\adjustright {\fs24 Range: 0\tab Components: S, M
\par Duration: Permanent\tab Casting Time: 1 turn
\par Area of Effect: Special\tab Saving Throw: Special
\par Subtlety: +5\tab Knockdown: Special
