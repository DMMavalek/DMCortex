\par }\pard\plain \s1\keep\nowidctlpar\tx1440\tx1710\tx2880\tx3150\tx4320\tx4770\tx6480\tx7200\tx7920{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\outlinelevel0\adjustright {Buckler\tab \tab +1\tab \tab +1\tab 1
\par }\pard\plain \keep\nowidctlpar\tx1440\tx1710\tx2880\tx3150\tx4320\tx4770\tx6480\tx7200\tx7920{\*\pn \pnlvlcont\ilvl0\ls0\pnrnot0\pndec }\adjustright \fs20\cgrid {\fs24\cgrid0 Small\tab \tab +1\tab \tab +2\tab 2
