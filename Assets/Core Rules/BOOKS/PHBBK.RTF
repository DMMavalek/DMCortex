\par }\pard\plain \keep\nowidctlpar\tx-720\tx7020\tx7380\adjustright \fs20 {\fs24 Scale mail or hide + shield, chain mail\tab \tab   5
\par Chain mail + shield, splint mail, banded mail, bronze plate mail\tab \tab   4
\par Splint mail, banded mail, or bronze plate mail + shield, plate mail\tab \tab   3
