\par 1d4 dryads\tab \tab 1%\tab \tab 25%\tab \tab 15%
\par 1d8 pixies\tab \tab 10%\tab \tab 20%\tab \tab 10%
\par 1d4 satyrs\tab \tab 1%\tab \tab 30%\tab \tab 10%
\par 1d6 sprites\tab \tab 0%\tab \tab   5%\tab \tab 25%
\par 1 treant\tab \tab --\tab \tab   5%\tab \tab 25%
