\par }\pard\plain \keep\nowidctlpar\tx-720\tx1440\tx1800\tx2880\tx3510\tx5040\tx5400\adjustright \fs20 {\fs24 2d8 brownies\tab \tab 30%\tab \tab 20%\tab \tab 10%
