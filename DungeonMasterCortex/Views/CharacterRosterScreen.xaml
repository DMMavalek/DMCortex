<UserControl x:Class="DungeonMasterCortex.Views.CharacterRosterScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="CHARACTERS"
                       Style="{StaticResource TitleText}" FontSize="20"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="+ NEW CHARACTER" Style="{StaticResource GoldButton}"
                        Margin="0,0,8,0" Width="170" Click="BtnNewCharacter_Click"/>
                <Button Content="REFRESH" Style="{StaticResource GoldButton}"
                        Margin="0,0,8,0" Width="100" Click="BtnRefresh_Click"/>
                <Button Content="UPDATE" Style="{StaticResource GoldButton}"
                    Margin="0,0,8,0" Width="100" Click="BtnLevelUp_Click"/>
                <Button Content="◀ HUB" Style="{StaticResource GoldButton}"
                        Width="100" Click="BtnHub_Click"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BrushBorder}" Margin="0,10,0,12"/>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="CharacterGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#20FFFFFF"
                      Background="{StaticResource BrushInputBg}"
                      Foreground="{StaticResource BrushText}"
                      BorderBrush="{StaticResource BrushBorder2}"
                      BorderThickness="1"
                      RowBackground="{StaticResource BrushInputBg}"
                      MouseDoubleClick="CharacterGrid_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BrushBtn}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushBtnTxt}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="170" Binding="{Binding Name}"/>
                    <DataGridTextColumn Header="Player Name" Width="130" Binding="{Binding PlayerName}"/>
                    <DataGridTextColumn Header="Party" Width="120" Binding="{Binding Party}"/>
                    <DataGridTextColumn Header="Race" Width="110" Binding="{Binding Race}"/>
                    <DataGridTextColumn Header="Class" Width="110" Binding="{Binding Class}"/>
                    <DataGridTextColumn Header="Level" Width="65" Binding="{Binding Level}"/>
                    <DataGridTextColumn Header="HPS" Width="65" Binding="{Binding HitPoints}"/>
                    <DataGridTextColumn Header="AC" Width="65" Binding="{Binding ArmorClass}"/>
                    <DataGridTextColumn Header="THAC0" Width="70" Binding="{Binding Thac0}"/>
                    <DataGridTextColumn Header="Revision" Width="80" Binding="{Binding Revision}"/>
                    <DataGridTextColumn Header="Date Last Modified" Width="150" Binding="{Binding LastModified}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="RosterStatus"
                       Grid.Row="1"
                       Style="{StaticResource SubtitleText}"
                       Margin="2,10,0,0"
                       Text="No characters yet. Click NEW CHARACTER to start."/>
        </Grid>
    </Grid>
</ScrollViewer>
</UserControl>
