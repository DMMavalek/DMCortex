<UserControl x:Class="DungeonMasterCortex.Views.CharGenSubAbilitiesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" Margin="24,20,24,20" MaxWidth="820">

            <TextBlock Text="SUB-ABILITY SCORES"
                       Style="{StaticResource TitleText}" FontSize="22"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Adjust sub-abilities  (each ±4 of base score)"
                       Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center" Margin="0,4,0,4"/>
            <TextBlock x:Name="ExStrBanner" Text=""
                       Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushTitle}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

            <!-- Exceptional Strength row (visible for warriors with STR 18) -->
            <Border x:Name="ExStrPanel" Visibility="Collapsed"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushTitle}"
                    BorderThickness="1" CornerRadius="2"
                    Margin="0,0,0,10" Padding="12,8">
                <StackPanel>
                    <TextBlock Text="⚔  EXCEPTIONAL STRENGTH  (Warriors / STR 18)"
                               FontFamily="Georgia" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTitle}"
                               HorizontalAlignment="Center"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Percentile roll (1–100)"
                                   Style="{StaticResource BodyText}" VerticalAlignment="Center" FontSize="12"/>
                        <Button Grid.Row="0" Grid.Column="1" x:Name="BtnExStrDec" Content="↓" Width="28" Height="24"
                            Padding="0" Style="{StaticResource GoldButton}" Click="BtnExStrDec_Click"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ExStrValue"
                                   FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTitle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Row="0" Grid.Column="3" x:Name="BtnExStrInc" Content="↑" Width="28" Height="24"
                            Padding="0" Style="{StaticResource GoldButton}" Click="BtnExStrInc_Click"/>
                        <TextBox Grid.Row="0" Grid.Column="4" x:Name="ExStrInput"
                                 Style="{StaticResource DarkTextBox}"
                                 FontSize="11" Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"
                                     KeyDown="ExStrInput_KeyDown"
                                     LostFocus="ExStrInput_LostFocus"
                                 ToolTip="Enter 1-100 (use 00 for 100)"/>
                        <Button Grid.Row="0" Grid.Column="5" x:Name="BtnExStrRoll" Content="ROLL d100"
                                Style="{StaticResource GoldButton}" Height="24"
                                Margin="8,0,0,0" Click="BtnExStrRoll_Click"/>
                        <CheckBox Grid.Row="0" Grid.Column="6" x:Name="ExStrLock"
                              Content="LOCK" Margin="8,0,0,0"
                              Foreground="{StaticResource BrushTitle}"
                              VerticalAlignment="Center"
                              Checked="ExStrLock_Checked"
                              Unchecked="ExStrLock_Unchecked"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="8" x:Name="ExStrEffect"
                                   Style="{StaticResource SubtitleText}" FontSize="10"
                               VerticalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Six ability group cards -->
            <ItemsControl x:Name="SubAbilityItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BrushCard}"
                                BorderBrush="{StaticResource BrushBorder2}"
                                BorderThickness="1" CornerRadius="2"
                                Margin="0,0,0,8" Padding="12,8">
                            <StackPanel>
                                <!-- Ability header -->
                                <TextBlock HorizontalAlignment="Center"
                                           FontFamily="Georgia" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTitle}">
                                    <Run Text="{Binding Abbrev}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text="  (base "/>
                                    <Run Text="{Binding BaseScore}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                                <!-- Racial modifier indicator -->
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{Binding ModifierColor}"
                                           FontSize="11" FontStyle="Italic"
                                           Text="{Binding ModifierLabel}"
                                           Margin="0,2,0,0"/>

                                <!-- Sub-ability rows (variable count) -->
                                <ItemsControl ItemsSource="{Binding Subs}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding SubName}"
                                                           Style="{StaticResource BodyText}"
                                                           VerticalAlignment="Center" FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <Button Grid.Column="1"
                                                    Content="↓" Width="28" Height="24" Padding="0"
                                                        Style="{StaticResource GoldButton}"
                                                        Tag="{Binding Key}"
                                                        Click="BtnDecrease_Click"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Score}"
                                                           FontFamily="Georgia" FontSize="16" FontWeight="Bold"
                                                           Foreground="{Binding ScoreColor}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button Grid.Column="3"
                                                    Content="↑" Width="28" Height="24" Padding="0"
                                                        Style="{StaticResource GoldButton}"
                                                        Tag="{Binding Key}"
                                                        Click="BtnIncrease_Click"/>
                                                <!-- Hint (what it governs) -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Hint}"
                                                           Style="{StaticResource SubtitleText}"
                                                           FontSize="10"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,4,0"
                                                           TextWrapping="Wrap"/>
                                                <!-- Current effect at this score -->
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding Effect}"
                                                           FontFamily="Consolas" FontSize="10"
                                                           Foreground="{StaticResource BrushTitle}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,12,0,12"/>
            <Button x:Name="BtnReset" Content="↺  RESET ALL TO BASE"
                    Style="{StaticResource GoldButton}" Width="200"
                    HorizontalAlignment="Center" Click="BtnReset_Click"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
