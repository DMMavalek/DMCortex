<Window x:Class="DungeonMasterCortex.Views.SphereSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Priest Sphere Selection" Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        Foreground="{StaticResource BrushText}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="PRIEST SPHERE SELECTION" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Check Minor and/or Major access for each sphere. Costs from your class CP budget."
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}"/>
        </StackPanel>

        <!-- Column headers -->
        <Grid Grid.Row="1" Margin="14,8,14,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Sphere" Style="{StaticResource LabelText}"/>
            <TextBlock Grid.Column="1" Text="Minor" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Major" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
        </Grid>

        <!-- Sphere list -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="14,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SphereItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5" MinHeight="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SphereLabel}"
                                           Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsMinor, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MinorCostStr}" Margin="4,0,0,0"
                                               Style="{StaticResource BodyText}" FontSize="11"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsMajor, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MajorCostStr}" Margin="4,0,0,0"
                                               Style="{StaticResource BodyText}" FontSize="11"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}"
                    BorderThickness="1" CornerRadius="2"
                    Padding="14,8" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="TotalCostLabel" Text="Total CP Cost:  0"
                           Style="{StaticResource LabelText}" FontSize="14"/>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnOK" Click="BtnOK_Click"
                        Padding="20,8" Margin="0,0,8,0"
                        Style="{StaticResource GoldButton}">Confirm</Button>
                <Button x:Name="BtnCancel" Click="BtnCancel_Click"
                        Padding="20,8"
                        Style="{StaticResource DarkButton}">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
