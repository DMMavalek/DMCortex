<Window x:Class="DungeonMasterCortex.Views.RogueSkillsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rogue Skill Allocation" Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}"
        Foreground="{StaticResource BrushText}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ROGUE SKILL ALLOCATION" Style="{StaticResource TitleText}" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock x:Name="IntroLabel"
                       Text="Allocate discretionary points across selected rogue skills."
                       Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Armor Profile" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
            <ComboBox x:Name="ArmorProfileCombo" Grid.Column="1"
                      Style="{StaticResource DarkComboBox}" Height="32"
                      SelectionChanged="ArmorProfileCombo_SelectionChanged"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="10,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="94"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Skill" Style="{StaticResource LabelText}"/>
                    <TextBlock Grid.Column="1" Text="Base" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Race" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="DEX" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="Armor" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="Allocate" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="Final" Style="{StaticResource SubtitleText}" HorizontalAlignment="Center"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="SkillItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" MinHeight="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="94"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SkillName}" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding BaseLabel}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RacialLabel}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DexLabel}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding ArmorLabel}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="5" Text="{Binding AllocatedPointsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Height="24" HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center" Margin="8,0,8,0"
                                             Background="#111111" Foreground="{StaticResource BrushLightGold}" BorderBrush="{StaticResource BrushBorder2}"/>
                                    <TextBlock Grid.Column="6" Text="{Binding FinalLabel}" Style="{StaticResource BodyText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource BrushTitle}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="PoolSummaryLabel" Text="" Style="{StaticResource SubtitleText}"/>
                <TextBlock x:Name="ValidationLabel" Text="" Style="{StaticResource BodyText}" Foreground="#C02828" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOK" Click="BtnOK_Click"
                        Padding="20,8" Margin="0,0,8,0"
                        Style="{StaticResource GoldButton}">Confirm</Button>
                <Button x:Name="BtnCancel" Click="BtnCancel_Click"
                        Padding="20,8"
                        Style="{StaticResource DarkButton}">Cancel</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>