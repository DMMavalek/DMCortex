<UserControl x:Class="DungeonMasterCortex.Views.SessionScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="900" Margin="24,24,24,32">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource BrushTitle}" Margin="6,0"/>
                    <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtTitle"
                           Text="SESSION MANAGER"
                           Style="{StaticResource TitleText}" FontSize="26"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtSubtitle"
                           Text="Host or join a local table session"
                           Style="{StaticResource SubtitleText}" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,24"/>

                <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,20"/>

                <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Current Session State" Style="{StaticResource TitleText}" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtSessionStatus" Style="{StaticResource SubtitleText}" Text="No active session."/>
                    </StackPanel>
                </Border>

                <Border x:Name="HostPanel" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Host Session" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Session Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtSessionName" Margin="0,0,0,10" MinWidth="260" Text="Saturday Table"/>
                        <TextBlock Text="Host Display Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtHostName" Margin="0,0,0,10" MinWidth="260" Text="Dungeon Master"/>
                        <TextBlock Text="Trust Mode" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbTrustMode" Margin="0,0,0,14" MinWidth="260"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnStartHosting" Content="START HOSTING" Style="{StaticResource GoldButton}" Width="150" Margin="0,0,10,0" Click="BtnStartHosting_Click"/>
                            <Button x:Name="BtnStopHosting" Content="STOP" Style="{StaticResource GoldButton}" Width="100" Click="BtnStopHosting_Click"/>
                        </StackPanel>

                        <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,14,0,12"/>

                        <TextBlock Text="Connected Participants" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstParticipants" Height="96" Margin="0,0,0,10"/>

                        <TextBlock Text="Synced Characters" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstSyncedCharacters" Height="92" Margin="0,0,0,10"/>

                        <TextBlock Text="Session Audit Log" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <ListBox x:Name="LstAuditLog" Height="120"/>
                    </StackPanel>
                </Border>

                <Border x:Name="JoinPanel" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="16" Margin="0,0,0,20" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="Find and Join Sessions" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,12"/>
                        <TextBlock Text="Player Display Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtPlayerName" Margin="0,0,0,10" MinWidth="260"/>
                        <TextBlock Text="Character" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbPlayerCharacter" Margin="0,0,0,10" MinWidth="260" DisplayMemberPath="DisplayName"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="BtnRefreshSessions" Content="FIND SESSIONS" Style="{StaticResource GoldButton}" Width="150" Margin="0,0,10,0" Click="BtnRefreshSessions_Click"/>
                            <Button x:Name="BtnJoinSession" Content="JOIN SELECTED" Style="{StaticResource GoldButton}" Width="150" Click="BtnJoinSession_Click"/>
                            <Button x:Name="BtnSyncNow" Content="SYNC NOW" Style="{StaticResource GoldButton}" Width="110" Margin="10,0,0,0" Click="BtnSyncNow_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtAutoSyncStatus" Style="{StaticResource SubtitleText}" Text="Auto-sync idle." Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtDiscoveryStatus" Style="{StaticResource SubtitleText}" Text="No discovery run yet." Margin="0,0,0,8"/>
                        <ListBox x:Name="LstSessions" Height="180" DisplayMemberPath="SessionName" SelectionChanged="LstSessions_SelectionChanged"/>
                        <TextBlock x:Name="TxtJoinHint"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"
                                   Text="LAN discovery uses UDP broadcast; join and character sync use TCP to the selected host."/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="◀  BACK TO HUB" Style="{StaticResource GoldButton}" Width="180" Click="BtnBack_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
