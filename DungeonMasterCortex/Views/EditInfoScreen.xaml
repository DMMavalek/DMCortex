                <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EquipmentEditorTitle" Text="Equipment Editor"
                                   Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,10"/>

                        <TextBlock Text="Item Id" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
