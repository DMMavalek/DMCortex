                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Max Weight" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                        <TextBox x:Name="EquipmentContainerMaxWeight" Style="{StaticResource DarkTextBox}" Text="0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Allowed Content Tags (comma-separated; blank = anything)" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
