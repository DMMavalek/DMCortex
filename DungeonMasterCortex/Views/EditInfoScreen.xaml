                        <Button Content="💾  SAVE KIT" Style="{StaticResource GoldButton}" Click="BtnSaveKit_Click"/>
                        <TextBlock x:Name="KitEditorInfo" Style="{StaticResource SubtitleText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
