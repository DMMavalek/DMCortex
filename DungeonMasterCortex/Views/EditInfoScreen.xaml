                        <TextBox x:Name="MonsterSource" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                        <TextBlock Text="Description" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                        <TextBox x:Name="MonsterDescription" Style="{StaticResource DarkTextBox}"
                                 Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <!-- Dragon Age Stages section (shown when the monster has age stage data) -->
                        <Border x:Name="AgeStagesSection" Visibility="Collapsed" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                                Padding="8">
                            <StackPanel>
                                <TextBlock Text="Dragon Age Stages" Style="{StaticResource TitleText}" Margin="0,0,0,6"/>
                                <DataGrid x:Name="AgeStagesGrid"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="False"
                                          GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="#20FFFFFF"
                                          Background="{StaticResource BrushInputBg}"
                                          Foreground="{StaticResource BrushText}"
                                          BorderBrush="{StaticResource BrushBorder2}"
                                          BorderThickness="1"
                                          RowBackground="{StaticResource BrushInputBg}"
                                          MinHeight="100"
                                          MaxHeight="300"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="{StaticResource BrushBtn}"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushBtnTxt}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"                 Width="28" Binding="{Binding StageNumber, Mode=OneWay}" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Age Category"      Width="90" Binding="{Binding Category}"/>
                                        <DataGridTextColumn Header="Hit Dice"          Width="56" Binding="{Binding HitDice}"/>
                                        <DataGridTextColumn Header="AC"                Width="36" Binding="{Binding ArmorClass}"/>
                                        <DataGridTextColumn Header="THAC0"             Width="46" Binding="{Binding Thac0}"/>
                                        <DataGridTextColumn Header="Breath Weapon"     Width="120" Binding="{Binding BreathWeapon}"/>
                                        <DataGridTextColumn Header="Spell Lvl"         Width="56" Binding="{Binding SpellLevel}"/>
                                        <DataGridTextColumn Header="Mag Res"           Width="56" Binding="{Binding MagicResistance}"/>
                                        <DataGridTextColumn Header="Special Abilities" Width="*" Binding="{Binding SpecialAbilities}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Initialize 12 Stages" Style="{StaticResource GoldButton}" Width="150"
                                            Click="BtnInitDragonStages_Click" Margin="0,0,8,0"/>
                                    <Button Content="✕ Clear Stages" Style="{StaticResource DangerButton}" Width="110"
                                            Click="BtnClearDragonStages_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ═══════════════════════════════════════════════════════════════ SPELLS TAB -->
            <Grid x:Name="TabSpells" Grid.Row="1" Visibility="Collapsed" KeyDown="TabSpells_KeyDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SpellSearchBox" Grid.Row="0" Style="{StaticResource DarkTextBox}"
                             Margin="0,0,0,6" TextChanged="SpellSearchBox_TextChanged"
                             Tag="Search spells…"/>
                    <TextBlock x:Name="SpellCountText" Grid.Row="1" Style="{StaticResource LabelText}"
                               Margin="2,0,0,6" Text="Showing 0 of 0 spells"/>
                    <ListBox x:Name="SpellListEditor" Grid.Row="2" Style="{StaticResource DarkListBox}"
                             DisplayMemberPath="Name"
                             SelectionChanged="SpellListEditor_SelectionChanged"/>
                        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="＋ New" Style="{StaticResource GoldButton}" MinWidth="92"
                                Click="BtnNewSpell_Click" Margin="0,0,6,0"/>
                        <Button Content="✕ Delete" Style="{StaticResource DangerButton}" MinWidth="92"
                                Click="BtnDeleteSpell_Click" Margin="0,0,6,0"/>
                        <Button Content="📤 Export" Style="{StaticResource GoldButton}" MinWidth="92"
                                Click="BtnExportSpells_Click" Margin="0,0,6,0"/>
                        <Button Content="📥 Import" Style="{StaticResource GoldButton}" MinWidth="92"
                                Click="BtnImportSpells_Click"/>
                        </WrapPanel>
                </Grid>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="0,0,0,1" Padding="0,6,12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Spell Editor" Style="{StaticResource TitleText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="💾 Save" Style="{StaticResource GoldButton}" Width="90"
                                    Click="BtnSaveSpell_Click" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SpellSavedIndicator" Text="✓ Saved" Foreground="#88DD88"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,12,0">

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SpellID" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellId" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Level" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellLevel" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellName" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Reversal" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellReversal" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Schools" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellSchools" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Range" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellRange" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Components" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellComponents" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Materials" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellMaterials" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Cast Time" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellCastTime" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Duration" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellDuration" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Area" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellArea" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Save" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellSave" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Frequency" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellFrequency" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Volume" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellVolume" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Page" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellPage" Style="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <Border BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="Damage" Style="{StaticResource TitleText}" FontSize="14" Margin="0,0,0,6"/>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Base Damage" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="SpellDamage" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                            <CheckBox x:Name="SpellIsHealing" Content="Healing (adds HP instead of damage)"
                                                      Margin="0,6,0,0"
                                                      Checked="SpellIsHealing_Changed"
                                                      Unchecked="SpellIsHealing_Changed"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Increase By" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="SpellDamageStep" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Start At Level" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="SpellDamageScaleStartLevel" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Increase Every" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="SpellDamageScaleEveryLevels" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Max At Level" Style="{StaticResource LabelText}"/>
                                            <TextBox x:Name="SpellDamageMaxAtLevel" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Max Damage" Style="{StaticResource LabelText}"/>
                                    <TextBox x:Name="SpellDamageMax" Style="{StaticResource DarkTextBox}" TextChanged="SpellDamageFields_TextChanged"/>
                                    <TextBlock x:Name="SpellDamagePreview" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock Text="Example: base 1d4+1, increase by 1d4+1, start at level 1, every 2 levels, max at level 10, max damage 5d4+5."
                                               Foreground="{StaticResource BrushDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Brief Description" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                            <TextBox x:Name="SpellBriefDescription" Style="{StaticResource DarkTextBox}"
                                     Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>

                            <TextBlock Text="Description" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                            <TextBox x:Name="SpellDescription" Style="{StaticResource DarkTextBox}"
                                     Height="260" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
