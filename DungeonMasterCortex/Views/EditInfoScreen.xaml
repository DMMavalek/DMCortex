                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Slots (Core)" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <TextBox x:Name="NwpEditSlots" Style="{StaticResource DarkTextBox}" Text="1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CP Cost (PO)" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <TextBox x:Name="NwpEditCpCost" Style="{StaticResource DarkTextBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Core Mod" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <TextBox x:Name="NwpEditCoreModifier" Style="{StaticResource DarkTextBox}" Text="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="PO Base" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <TextBox x:Name="NwpEditPoModifier" Style="{StaticResource DarkTextBox}" Text="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Core / PO check ability -->
                        <TextBlock Text="Core Check Ability" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="NwpEditCoreAbility" Style="{StaticResource DarkComboBox}" Margin="0,0,0,8">
                            <ComboBoxItem Content="Strength"/>
                            <ComboBoxItem Content="Dexterity"/>
                            <ComboBoxItem Content="Constitution"/>
                            <ComboBoxItem Content="Intelligence" IsSelected="True"/>
                            <ComboBoxItem Content="Wisdom"/>
                            <ComboBoxItem Content="Charisma"/>
                            <ComboBoxItem Content="None"/>
                        </ComboBox>

                        <TextBlock Text="PO Check Ability / Subability" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <ComboBox x:Name="NwpEditPoAbility" Style="{StaticResource DarkComboBox}" Margin="0,0,0,8">
                            <ComboBoxItem Content="Strength"/>
                            <ComboBoxItem Content="Str — Stamina"/>
                            <ComboBoxItem Content="Str — Muscle"/>
                            <Separator/>
                            <ComboBoxItem Content="Dexterity"/>
                            <ComboBoxItem Content="Dex — Aim"/>
                            <ComboBoxItem Content="Dex — Balance"/>
                            <Separator/>
                            <ComboBoxItem Content="Constitution"/>
                            <ComboBoxItem Content="Con — Health"/>
                            <ComboBoxItem Content="Con — Fitness"/>
                            <Separator/>
                            <ComboBoxItem Content="Intelligence" IsSelected="True"/>
                            <ComboBoxItem Content="Int — Reason"/>
                            <ComboBoxItem Content="Int — Knowledge"/>
                            <Separator/>
                            <ComboBoxItem Content="Wisdom"/>
                            <ComboBoxItem Content="Wis — Intuition"/>
                            <ComboBoxItem Content="Wis — Willpower"/>
                            <ComboBoxItem Content="Wis — Perception"/>
                            <Separator/>
                            <ComboBoxItem Content="Charisma"/>
                            <ComboBoxItem Content="Cha — Leadership"/>
                            <ComboBoxItem Content="Cha — Appearance"/>
                            <Separator/>
                            <ComboBoxItem Content="None"/>
                        </ComboBox>
                        <!-- DM Settings -->
                        <TextBlock Text="DM Settings" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <CheckBox x:Name="NwpAllowMultipleCheck"
                                  Content="Allow this proficiency to be selected more than once"
                                  Foreground="{StaticResource BrushText}"
                                  Margin="0,0,0,6"
                                  Checked="NwpSettingCheckbox_Changed"
                                  Unchecked="NwpSettingCheckbox_Changed"/>
                        <CheckBox x:Name="NwpRequireTextCheck"
                                  Content="Require player text note when selected"
                                  Foreground="{StaticResource BrushText}"
                                  Margin="0,0,0,12"
                                  Checked="NwpSettingCheckbox_Changed"
                                  Unchecked="NwpSettingCheckbox_Changed"/>

                        <!-- Description -->
                        <TextBlock Text="Description" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <!-- Allowed Classes -->
                        <TextBlock Text="Allowed Classes" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBlock Text="Class IDs, comma-separated. Blank = available to all classes."
                                   Style="{StaticResource SubtitleText}" FontSize="10"
                                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,3"/>
                        <TextBox x:Name="NwpEditAllowedClasses" Style="{StaticResource DarkTextBox}"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Master Import Reference" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="NwpImportReference" Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="180" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <TextBlock Text="Description" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NwpEditorDescription" Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>

                        <!-- Save definition button -->
                        <Button Content="💾  SAVE PROFICIENCY DEFINITION" Style="{StaticResource GoldButton}"
                                Click="BtnSaveNwpDefinition_Click"/>
                        <TextBlock x:Name="NwpEditorInfo" Style="{StaticResource SubtitleText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ TRAITS TAB ═══ -->
            <Grid x:Name="TabTraits" Grid.Row="1" Visibility="Collapsed">
