                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,16,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="💾  SAVE GROUP" Style="{StaticResource GoldButton}"
                                                Margin="0,0,8,0" Click="BtnSaveMultiClassGroup_Click"/>
                                        <Button x:Name="BtnDeleteMultiClassGroup" Content="🗑  Delete Group"
                                                Style="{StaticResource DangerButton}" IsEnabled="False"
                                                Click="BtnDeleteMultiClassGroup_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="MultiClassEditorInfo" Style="{StaticResource SubtitleText}"
