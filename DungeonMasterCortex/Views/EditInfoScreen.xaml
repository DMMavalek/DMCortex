                    <ListBox x:Name="TraitListEditor" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}" Height="300" SelectionChanged="TraitListEditor_SelectionChanged"/>
                    <Button Content="＋  New Trait" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Click="BtnNewTrait_Click"/>
                    <Button x:Name="BtnDeleteTrait" Content="🗑  Delete" Style="{StaticResource DangerButton}" Margin="0,6,0,0" Click="BtnDeleteTrait_Click" IsEnabled="False"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="Trait Editor" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,10"/>
