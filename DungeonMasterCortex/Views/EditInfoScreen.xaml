                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Disadvantages" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DisadvantageSearch" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6" TextChanged="DisadvantageSearch_TextChanged"/>
                    <ListBox x:Name="DisadvantageListEditor" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}" Height="300" SelectionChanged="DisadvantageListEditor_SelectionChanged"/>
                    <Button Content="＋  New Disadvantage" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Click="BtnNewDisadvantage_Click"/>
                    <Button x:Name="BtnDeleteDisadvantage" Content="🗑  Delete" Style="{StaticResource DangerButton}" Margin="0,6,0,0" Click="BtnDeleteDisadvantage_Click" IsEnabled="False"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}" VerticalAlignment="Stretch"/>

                <StackPanel Grid.Column="2" Margin="16,0,0,0">
                    <TextBlock Text="Disadvantage Editor" Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,10"/>
                    <TextBlock Text="Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                    <TextBox x:Name="DisadvantageName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Moderate Bonus" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                            <TextBox x:Name="DisadvantageModerate" Style="{StaticResource DarkTextBox}" Text="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Severe Bonus (blank = none)" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                            <TextBox x:Name="DisadvantageSevere" Style="{StaticResource DarkTextBox}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Description" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                    <TextBox x:Name="DisadvantageDescription" Style="{StaticResource DarkTextBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10"/>
                    <Button Content="💾  SAVE DISADVANTAGE" Style="{StaticResource GoldButton}" Click="BtnSaveDisadvantage_Click"/>
                    <TextBlock x:Name="DisadvantageEditorInfo" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- ═══ KITS TAB ═══ -->
            <Grid x:Name="TabKits" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Kits" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBox x:Name="KitEditorSearch" Style="{StaticResource DarkTextBox}" Margin="0,0,0,4"
                                 TextChanged="KitEditorSearch_TextChanged"
                                 Tag="Search kits…"/>
                        <ComboBox x:Name="KitSourceFilter" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="KitSourceFilter_Changed">
                            <ComboBoxItem Content="All Sources" IsSelected="True"/>
                            <ComboBoxItem Content="Complete Book of Elves"/>
                            <ComboBoxItem Content="Complete Book of Dwarves"/>
                            <ComboBoxItem Content="Complete Book of Gnomes &amp; Halflings"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </StackPanel>
                    <ListBox x:Name="KitListEditor" Grid.Row="1" Style="{StaticResource DarkListBox}"
