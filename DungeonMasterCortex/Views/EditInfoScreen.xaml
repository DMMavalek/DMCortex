                                       Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RaSubAbility" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                            <TextBlock Text="Enemy Attack Bonuses  (e.g.  goblinoids:1, giants:1)"
                                       Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RaEnemyAttack" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                            <TextBlock Text="Enemy Damage Bonuses  (e.g.  orcs:1, undead:2)"
                                       Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
