                                    <TextBlock Text="Race Group Key" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBlock Text="Lowercase group name: elf, half-elf, dwarf, gnome, halfling, half-orc, half-ogre"
                                               Style="{StaticResource SubtitleText}" FontSize="10"
                                               Foreground="{StaticResource BrushDim}" Margin="0,0,0,3"/>
                                    <TextBox x:Name="MultiClassEditRaceGroup" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>

                                    <TextBlock Text="Source" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="MultiClassEditSource" Style="{StaticResource DarkTextBox}" Margin="0,0,0,12"/>

                                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>
