                                <CheckBox x:Name="CaStealth" Content="Grants Stealth"
                                          Foreground="{StaticResource BrushText}" Margin="0,0,16,4"/>
                                <CheckBox x:Name="CaDetectDoors" Content="Detect Secret Doors"
                                          Foreground="{StaticResource BrushText}" Margin="0,0,16,4"/>
                                <CheckBox x:Name="CaDetectStone" Content="Detect Stonework"
                                          Foreground="{StaticResource BrushText}" Margin="0,0,16,4"/>
                            </WrapPanel>

