                                    MinWidth="130" Margin="0,0,8,0" Click="BtnNewNwp_Click"/>
                            <Button x:Name="BtnDeleteNwp" Content="🗑  Delete"
                                    Style="{StaticResource DangerButton}" MinWidth="100"
                                    IsEnabled="False" Click="BtnDeleteNwp_Click"/>
