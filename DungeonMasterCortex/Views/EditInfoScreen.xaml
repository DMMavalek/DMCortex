                        <TextBlock x:Name="EquipmentEditorInfo" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ CLASSES TAB ═══ -->
            <Grid x:Name="TabClasses" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Classes" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ListBox x:Name="ClassDefListEditor" Style="{StaticResource DarkListBox}" ItemContainerStyle="{StaticResource DarkListBoxItem}" Height="300" SelectionChanged="ClassDefListEditor_SelectionChanged"/>
                    <Button Content="＋  NEW CLASS" Style="{StaticResource GoldButton}" Margin="0,8,0,0" Click="BtnNewClassDefinition_Click"/>
