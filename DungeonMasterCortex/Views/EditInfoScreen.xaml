<UserControl x:Class="DungeonMasterCortex.Views.EditInfoScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <TextBlock Text="EDIT INFORMATION"
                       Style="{StaticResource TitleText}" FontSize="20"
                       VerticalAlignment="Center"/>
            <Button Content="◀  DM TOOLS" Style="{StaticResource GoldButton}"
                    HorizontalAlignment="Right" Width="150" Click="BtnBack_Click"/>
        </Grid>
        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BrushBorder}" Margin="0,10,0,12"/>

        <!-- Tab strip -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab buttons -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="TabBtnChars" Content="Player Characters"
                        Style="{StaticResource GoldButton}" Width="170"
                        Click="TabChars_Click" Margin="0,0,8,0"/>

                    <Button x:Name="TabBtnOptions" Content="Character Options"
                        Style="{StaticResource GoldButton}" Width="160"
                        Click="TabOptions_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnEquipmnet" Content="Equipment"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabEquipmnet_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnRaces" Content="Races"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabRaces_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnClasses" Content="Classes"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabClasses_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnMonsters" Content="Monsters"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabBtnMonsters_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnSpells" Content="Spells"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabBtnSpells_Click"/>
                </WrapPanel>

                <WrapPanel x:Name="OptionsSubTabStrip" Visibility="Collapsed" Margin="0,0,0,4">
                    <Button x:Name="TabBtnNwps" Content="NWPs"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabNwps_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnTraits" Content="Traits"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabTraits_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnDisadvantages" Content="Disadvantages"
                        Style="{StaticResource GoldButton}" Width="140"
                        Click="TabDisadvantages_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnKits" Content="Kits"
                        Style="{StaticResource GoldButton}" Width="100"
                        Click="TabBtnKits_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="TabBtnMultiClass" Content="Multi-Class"
                                        Style="{StaticResource GoldButton}" Width="120"
                                        Click="TabBtnMultiClass_Click" Margin="0,0,8,0"/>
                                </WrapPanel>

                                <WrapPanel x:Name="RacesSubTabStrip" Visibility="Collapsed" Margin="0,0,0,4">
                    <Button x:Name="TabSubBtnRaces" Content="Race Definitions"
                        Style="{StaticResource GoldButton}" Width="150"
                        Click="TabRaces_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnRacialAbilities" Content="Racial Abilities"
                        Style="{StaticResource GoldButton}" Width="150"
                        Click="TabRacialAbilities_Click"/>
                                </WrapPanel>

                                <WrapPanel x:Name="ClassesSubTabStrip" Visibility="Collapsed" Margin="0,0,0,4">
                    <Button x:Name="TabSubBtnClasses" Content="Class Definitions"
                        Style="{StaticResource GoldButton}" Width="150"
                        Click="TabClasses_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnClassAbilities" Content="Class Abilities"
                        Style="{StaticResource GoldButton}" Width="150"
                        Click="TabClassAbilities_Click"/>
                                </WrapPanel>

                                <WrapPanel x:Name="SpellsSubTabStrip" Visibility="Collapsed" Margin="0,0,0,4">
                    <Button x:Name="TabBtnSpellsArcane" Content="Arcane"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabSpellsArcane_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnSpellsDivine" Content="Divine"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabSpellsDivine_Click" Margin="0,0,8,0"/>
                    <Button x:Name="TabBtnSpellsPsionic" Content="Psionic"
                        Style="{StaticResource GoldButton}" Width="120"
                        Click="TabSpellsPsionic_Click"/>
                                </WrapPanel>
            </StackPanel>

            <!-- ═══ CHARACTERS TAB ═══ -->
            <Grid x:Name="TabChars" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- List -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Created Characters" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ListBox x:Name="CharList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             Height="340" SelectionChanged="CharList_SelectionChanged"/>
                    <Button Content="↺  REFRESH" Style="{StaticResource GoldButton}"
                            Margin="0,8,0,0" Click="BtnRefreshChars_Click"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                           VerticalAlignment="Stretch"/>

                <!-- Detail / edit panel -->
                <Grid Grid.Column="2" Margin="16,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="CharDetailTitle" Grid.Row="0"
                               Text="Select a character"
                               Style="{StaticResource TitleText}" FontSize="16"
                               Margin="0,0,0,10"/>

                    <!-- Ability grid read-only -->
                    <StackPanel Grid.Row="1">
                        <ItemsControl x:Name="CharAbilityDisplay" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BrushBtn}"
                                            BorderBrush="{StaticResource BrushBorder2}"
                                            BorderThickness="1" CornerRadius="2"
                                            Width="72" Height="68" Margin="0,0,6,0">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Score}"
                                                       FontFamily="Georgia" FontSize="20" FontWeight="Bold"
                                                       Foreground="{Binding ScoreColor}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding Abbrev}"
                                                       Style="{StaticResource SubtitleText}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Racial Abilities:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ItemsControl x:Name="CharRacialAbilities" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="TabBtnCharHealing"
                            Content="Healing"
                            Style="{StaticResource GoldButton}"
                            Width="130"
                            Margin="0,0,8,0"
                            Click="TabBtnCharHealing_Click"/>
                        <Button x:Name="TabBtnCharUpdate"
                            Content="Character Update"
                            Style="{StaticResource GoldButton}"
                            Width="170"
                            Click="TabBtnCharUpdate_Click"/>
                        </StackPanel>

                        <!-- Character Health editor -->
                        <Border x:Name="CharHealingPanel" Grid.Row="3" Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Character Health" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Current HP" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="CharCurrentHp" Style="{StaticResource BodyText}" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Max HP" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="CharMaxHp" Style="{StaticResource BodyText}" Margin="0,0,0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Heal Amount" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharHealInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="💚  HEAL CHARACTER" Style="{StaticResource GoldButton}" Width="190" HorizontalAlignment="Left" Click="BtnHealCharacter_Click"/>

                            <TextBlock Text="Use Healing Spell" Style="{StaticResource SubtitleText}" Margin="0,10,0,4"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CharHealingSpellPicker" Grid.Column="0" Style="{StaticResource DarkComboBox}" MinWidth="220"/>
                                <TextBox x:Name="CharSpellHealAmount" Grid.Column="2" Style="{StaticResource DarkTextBox}" Text="0"/>
                                <Button Grid.Column="4" Content="CAST HEALING SPELL" Style="{StaticResource GoldButton}" Click="BtnHealFromSpell_Click"/>
                            </Grid>

                            <TextBlock Text="Use Healing Item (Inventory)" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CharHealingItemPicker" Grid.Column="0" Style="{StaticResource DarkComboBox}" MinWidth="220"/>
                                <TextBox x:Name="CharItemHealAmount" Grid.Column="2" Style="{StaticResource DarkTextBox}" Text="0"/>
                                <Button Grid.Column="4" Content="USE ITEM TO HEAL" Style="{StaticResource GoldButton}" Click="BtnHealFromItem_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Level-up / progression editor -->
                    <Border x:Name="CharUpdatePanel" Grid.Row="4" Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Level-Up &amp; CP Spending" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Add XP" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharXpGainInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Add HP" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharHpGainInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Add CP" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharCpGainInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="⬆  APPLY LEVEL UPDATE" Style="{StaticResource GoldButton}" Width="190" HorizontalAlignment="Left" Click="BtnApplyLevelUpdate_Click"/>

                            <Grid Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Spend CP on NWPs" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharSpendNwpCpInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Spend CP on Weapons" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                    <TextBox x:Name="CharSpendWeaponCpInput" Style="{StaticResource DarkTextBox}" Text="0"/>
                                </StackPanel>
                            </Grid>

                            <Button Content="💾  SPEND CP" Style="{StaticResource GoldButton}" Width="130" HorizontalAlignment="Left" Click="BtnSpendCharacterCp_Click"/>

                            <TextBlock Text="Currency" Style="{StaticResource SubtitleText}" Margin="0,10,0,2"/>
                            <TextBlock x:Name="CharCoinSummary" Style="{StaticResource SubtitleText}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Button Content="🛒  BUY ITEM"
                                        Style="{StaticResource GoldButton}"
                                        Width="130"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnBuyItem_Click"/>
                                <Button Content="💰  SELL / ADD FUNDS"
                                        Style="{StaticResource GoldButton}"
                                        Width="170"
                                        HorizontalAlignment="Left"
                                        Click="BtnSellItem_Click"/>
                            </StackPanel>

                            <TextBlock x:Name="CharProgressSummary" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="CharLevelupInfo" Style="{StaticResource SubtitleText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Notes editor -->
                    <StackPanel x:Name="CharNotesPanel" Grid.Row="5">
                        <TextBlock Text="Notes:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="CharNotes"
                                 Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="124"/>
                    </StackPanel>

                    <StackPanel x:Name="CharNotesActionsPanel" Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="💾  SAVE NOTES"
                                Style="{StaticResource GoldButton}"
                                HorizontalAlignment="Left"
                                Click="BtnSaveNotes_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ═══ RACES TAB ═══ -->
            <Grid x:Name="TabRaces" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Races" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ListBox x:Name="RaceListEditor" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             Height="300" SelectionChanged="RaceListEditor_SelectionChanged"/>
                    <Button Content="+  NEW RACE" Style="{StaticResource GoldButton}"
                            Margin="0,8,0,0" Click="BtnNewRace_Click"/>
                    <Button Content="💾  SAVE RACE" Style="{StaticResource GoldButton}"
                            Margin="0,6,0,0" Click="BtnSaveRace_Click"/>
                    <Button Content="🗑  DELETE" Style="{StaticResource DangerButton}"
                            Margin="0,6,0,0" Click="BtnDeleteRace_Click"/>
                        <Button Content="📤  EXPORT CUSTOM PACK" Style="{StaticResource GoldButton}"
                            Margin="0,12,0,0" Click="BtnExportCustomPack_Click"/>
                        <Button Content="📥  IMPORT CUSTOM PACK" Style="{StaticResource GoldButton}"
                            Margin="0,6,0,0" Click="BtnImportCustomPack_Click"/>
                </StackPanel>

                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                           VerticalAlignment="Stretch"/>

                <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Race Editor" Style="{StaticResource TitleText}" FontSize="16"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Race Id:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RaceId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Display Name:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RaceName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Base Race Id:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RaceBaseId" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Character Mode:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="RaceMode" SelectedIndex="0" Margin="0,0,0,10">
                            <ComboBoxItem Content="All Characters" Tag="all"/>
                            <ComboBoxItem Content="Core Rules Only" Tag="core_rules"/>
                            <ComboBoxItem Content="Player's Option Only" Tag="players_option"/>
                        </ComboBox>

                        <TextBlock Text="Racial Point Budget:" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RacePointBudget" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"/>

                        <TextBlock Text="Ability Limits" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Min" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Max" Style="{StaticResource SubtitleText}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="STR" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceStrMin" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,6"/>
                            <TextBox x:Name="RaceStrMax" Grid.Row="1" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="DEX" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceDexMin" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,6"/>
                            <TextBox x:Name="RaceDexMax" Grid.Row="2" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="CON" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceConMin" Grid.Row="3" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,6"/>
                            <TextBox x:Name="RaceConMax" Grid.Row="3" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="INT" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceIntMin" Grid.Row="4" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,6"/>
                            <TextBox x:Name="RaceIntMax" Grid.Row="4" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="WIS" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceWisMin" Grid.Row="5" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,6"/>
                            <TextBox x:Name="RaceWisMax" Grid.Row="5" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="CHA" Style="{StaticResource LabelText}" Margin="0,4,0,0"/>
                            <TextBox x:Name="RaceChaMin" Grid.Row="6" Grid.Column="1" Style="{StaticResource DarkTextBox}" Margin="0,0,6,0"/>
                            <TextBox x:Name="RaceChaMax" Grid.Row="6" Grid.Column="2" Style="{StaticResource DarkTextBox}" Margin="0,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Racial Abilities (one per line):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RaceAbilities" Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="120" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>

                        <TextBlock Text="Structured Abilities (id|cost|auto|description|mechanicsJson):" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBlock Text="Example: helf_bow_atk|5|false|Bow bonus (5): +1 on attacks with long or short bows.|{&quot;weapon_attack_bonuses&quot;:{&quot;bows&quot;:1}}"
                                   Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBox x:Name="RaceAbilityDefs" Style="{StaticResource DarkTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="190" VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ NWPS TAB ═══ -->
            <Grid x:Name="TabNwps" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: filters + list + action buttons -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="Nonweapon Proficiencies" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                        <TextBlock Text="Search" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="NwpEditorSearch" Style="{StaticResource DarkTextBox}"
                                 Margin="0,0,0,6" TextChanged="NwpEditorSearch_TextChanged"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="NwpCategoryFilter" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="NwpFilterChanged">
                                    <ComboBoxItem Content="All Categories" IsSelected="True"/>
                                    <ComboBoxItem Content="General"/>
                                    <ComboBoxItem Content="Warrior"/>
                                    <ComboBoxItem Content="Priest"/>
                                    <ComboBoxItem Content="Rogue"/>
                                    <ComboBoxItem Content="Mage"/>
                                    <ComboBoxItem Content="Psionicist"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Source" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="NwpSourceFilter" Style="{StaticResource DarkComboBox}"
                                          SelectionChanged="NwpFilterChanged">
                                    <ComboBoxItem Content="All Sources" IsSelected="True"/>
                                    <ComboBoxItem Content="Core"/>
                                    <ComboBoxItem Content="Player's Option"/>
                                    <ComboBoxItem Content="Core &amp; Player's Option"/>
                                    <ComboBoxItem Content="Supplement"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="NwpSourceDiagnosticsText"
                                   Style="{StaticResource SubtitleText}" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{StaticResource BrushDim}"/>
                    </StackPanel>

                    <ListBox x:Name="NwpEditorList" Grid.Row="1" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             SelectionChanged="NwpEditorList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMissingPo}" Value="True">
                                                    <Setter Property="Foreground" Value="#FFA040"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
