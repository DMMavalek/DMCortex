                    <Border Grid.Row="0" Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="0,0,0,1" Padding="0,6,12,6" Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Monster Editor" Style="{StaticResource TitleText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="⚔ Add To Combat Tracker" Style="{StaticResource GoldButton}" Width="190"
                                Click="BtnAddMonsterToCombatTracker_Click" Margin="0,0,6,0"/>
                            <Button Content="💾 Save" Style="{StaticResource GoldButton}" Width="90"
                                    Click="BtnSaveMonster_Click" Margin="0,0,6,0"/>
                            <TextBlock x:Name="MonsterSavedIndicator" Text="✓ Saved" Foreground="#88DD88"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,8,12,0">

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Name" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterName" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Monster Type" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterType" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hit Dice" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterHitDice" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Armor Class" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterAC" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="THAC0" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterThac0" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Movement" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterMovement" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Attacks" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterAttacks" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Damage" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterDamage" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Size" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterSize" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Intelligence" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterIntelligence" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Alignment" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterAlignment" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Morale" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterMorale" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="XP Value" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterXP" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="# Appearing" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterNumAppearing" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Frequency" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterFrequency" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Treasure Type" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterTreasure" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Magic Resistance" Style="{StaticResource LabelText}"/>
                                <TextBox x:Name="MonsterMagicRes" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Special Attacks" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                        <TextBox x:Name="MonsterSpecialAttacks" Style="{StaticResource DarkTextBox}"
