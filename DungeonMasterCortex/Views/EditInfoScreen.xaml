                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>

                        <TextBlock Text="Special Defenses" Style="{StaticResource LabelText}" Margin="0,4,0,2"/>
                        <TextBox x:Name="MonsterSpecialDefenses" Style="{StaticResource DarkTextBox}"
                                 Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"/>

