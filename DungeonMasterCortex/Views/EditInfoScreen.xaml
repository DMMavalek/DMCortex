                    <TextBlock x:Name="TraitEditorInfo" Style="{StaticResource SubtitleText}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- ═══ DISADVANTAGES TAB ═══ -->
            <Grid x:Name="TabDisadvantages" Grid.Row="1" Visibility="Collapsed">
