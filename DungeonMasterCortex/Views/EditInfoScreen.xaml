                <!-- Right: edit form -->
                <ScrollViewer Grid.Column="2" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="NwpEditorTitle" Text="Edit Proficiency"
                                   Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,10"/>

                        <!-- Name -->
                        <TextBlock Text="Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="NwpEditName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>

                        <!-- Category + Source -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="NwpEditCategory" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="General"/>
                                    <ComboBoxItem Content="Warrior"/>
                                    <ComboBoxItem Content="Priest"/>
                                    <ComboBoxItem Content="Rogue"/>
                                    <ComboBoxItem Content="Mage"/>
                                    <ComboBoxItem Content="Psionicist"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Source" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                                <ComboBox x:Name="NwpEditSource" Style="{StaticResource DarkComboBox}">
                                    <ComboBoxItem Content="Core"/>
                                    <ComboBoxItem Content="Player's Option"/>
                                    <ComboBoxItem Content="Core &amp; Player's Option"/>
                                    <ComboBoxItem Content="Supplement"/>
                                    <ComboBoxItem Content="Custom"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Slots / Ability / Modifier -->
