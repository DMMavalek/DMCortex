                                <TextBox x:Name="EquipmentEditCostCopper" Style="{StaticResource DarkTextBox}" Text="0"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
