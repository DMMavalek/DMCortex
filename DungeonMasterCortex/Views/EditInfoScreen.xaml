                        <TextBox x:Name="KitEditName" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="Source" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="KitEditSource" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="Allowed Races" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBlock Text="Race IDs, comma-separated. Blank = available to all races."
                                   Style="{StaticResource SubtitleText}" FontSize="10"
                                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,3"/>
                        <TextBox x:Name="KitEditAllowedRaces" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="Allowed Classes" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBlock Text="Class IDs, comma-separated. Blank = available to all classes."
                                   Style="{StaticResource SubtitleText}" FontSize="10"
                                   Foreground="{StaticResource BrushDim}" Margin="0,0,0,3"/>
                        <TextBox x:Name="KitEditAllowedClasses" Style="{StaticResource DarkTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="Description" Style="{StaticResource SubtitleText}" Margin="0,0,0,2"/>
                        <TextBox x:Name="KitEditDescription" Style="{StaticResource DarkTextBox}"
