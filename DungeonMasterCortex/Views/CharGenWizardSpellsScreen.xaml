<UserControl x:Class="DungeonMasterCortex.Views.CharGenWizardSpellsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="WIZARD SPELLBOOK" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4"/>
            <TextBlock Text="Choose arcane spells your wizard can learn and organize named spell lists."
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
            <TextBlock x:Name="DailySlotsSummary" Style="{StaticResource BodyText}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,10"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Available spells" Style="{StaticResource SubtitleText}"/>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}"
                                 TextChanged="SearchBox_TextChanged"/>
                        <ComboBox x:Name="SortByPicker"
                                  Grid.Column="2"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="SortByPicker_SelectionChanged"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="FilterLevelPicker"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="FilterLevelPicker_SelectionChanged"/>
                        <ComboBox x:Name="FilterSchoolPicker"
                                  Grid.Column="2"
                                  Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="FilterSchoolPicker_SelectionChanged"/>
                    </Grid>

                    <TextBlock Grid.Row="3" x:Name="AvailableSummary" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>

                    <ListBox Grid.Row="5" x:Name="AvailableSpellList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="AvailableSpellList_SelectionChanged"
                             MouseDoubleClick="AvailableSpellList_MouseDoubleClick"
                             PreviewMouseRightButtonUp="AvailableSpellList_MouseRightButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="0,1,0,0" Margin="0,0,0,4" Visibility="Collapsed" x:Name="LevelDivider"/>
                                    <TextBlock Grid.Column="0" Text="{Binding LevelText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Style="{StaticResource BodyText}" TextWrapping="Wrap">
                                        <TextBlock.ToolTip>
                                            <ToolTip Placement="Mouse">
                                                <TextBlock Text="{Binding Spell.BriefDescription}" TextWrapping="Wrap" Width="320"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowLevelDivider}" Value="True">
                                        <Setter TargetName="LevelDivider" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="BtnLearnSpell" Content="LEARN  ▶" Style="{StaticResource GoldButton}"
                        Margin="0,0,0,10" Click="BtnLearnSpell_Click" IsEnabled="False"/>
                <Button x:Name="BtnUnlearnSpell" Content="◀  FORGET" Style="{StaticResource DarkButton}"
                        Margin="0,0,0,10" Click="BtnUnlearnSpell_Click" IsEnabled="False"/>
                <Rectangle Height="1" Fill="{StaticResource BrushBorder2}" Margin="0,6,0,10"/>
                <TextBlock Text="Roll (d100)" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                <TextBox x:Name="ManualRollBox" Style="{StaticResource DarkTextBox}" Margin="0,0,0,6"/>
                <CheckBox x:Name="OverrideFailureCheck"
                          Content="Override failure"
                          Foreground="{StaticResource BrushText}"
                          Margin="0,0,0,8"/>
                <TextBlock x:Name="LearnChanceText" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock x:Name="LearnRollResult" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Known spellbook" Style="{StaticResource SubtitleText}"/>
                        <TextBlock x:Name="KnownSummary" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ListBox Grid.Row="2" x:Name="KnownSpellList"
                             Height="180"
                             SelectionChanged="KnownSpellList_SelectionChanged"
                             PreviewMouseRightButtonUp="KnownSpellList_MouseRightButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="3" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="0,1,0,0" Margin="0,0,0,4" Visibility="Collapsed" x:Name="LevelDividerKnown"/>
                                    <TextBlock Grid.Column="0" Text="{Binding LevelText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayText}" Style="{StaticResource BodyText}" TextWrapping="Wrap">
                                        <TextBlock.ToolTip>
                                            <ToolTip Placement="Mouse">
                                                <TextBlock Text="{Binding Spell.BriefDescription}" TextWrapping="Wrap" Width="320"/>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding ShowLevelDivider}" Value="True">
                                        <Setter TargetName="LevelDividerKnown" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Named spell lists" Style="{StaticResource SubtitleText}"/>

                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewListNameBox" Grid.Column="0" Style="{StaticResource DarkTextBox}"/>
                                <Button x:Name="BtnCreateList" Grid.Column="2" Content="CREATE" Style="{StaticResource GoldButton}" Click="BtnCreateList_Click"/>
                                <Button x:Name="BtnRemoveList" Grid.Column="4" Content="DELETE" Style="{StaticResource DangerButton}" Click="BtnRemoveList_Click"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ListBox x:Name="SpellListsList"
                                         Grid.Column="0"
                                         SelectionChanged="SpellListsList_SelectionChanged"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                    <Button x:Name="BtnAddToList" Content="ADD ▶" Style="{StaticResource GoldButton}"
                                            Margin="0,0,0,8" Click="BtnAddToList_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnRemoveFromList" Content="◀ REMOVE" Style="{StaticResource DarkButton}"
                                            Click="BtnRemoveFromList_Click" IsEnabled="False"/>
                                </StackPanel>

                                <ListBox x:Name="ListSpellsList"
                                         Grid.Column="2"
                                         SelectionChanged="ListSpellsList_SelectionChanged"
                                         PreviewMouseRightButtonUp="ListSpellsList_MouseRightButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,2">
                                                <Border BorderBrush="{StaticResource BrushBorder2}" BorderThickness="0,1,0,0" Margin="0,0,0,4" Visibility="Collapsed" x:Name="LevelDividerNamed"/>
                                                <TextBlock Text="{Binding SpellName}" Style="{StaticResource BodyText}" TextWrapping="Wrap">
                                                    <TextBlock.ToolTip>
                                                        <ToolTip Placement="Mouse">
                                                            <TextBlock Text="{Binding Spell.BriefDescription}" TextWrapping="Wrap" Width="320"/>
                                                        </ToolTip>
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </StackPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ShowLevelDivider}" Value="True">
                                                    <Setter TargetName="LevelDividerNamed" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
