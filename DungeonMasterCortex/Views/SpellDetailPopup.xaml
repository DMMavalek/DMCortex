<Window x:Class="DungeonMasterCortex.Views.SpellDetailPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#CC222222" 
        ShowInTaskbar="False" SizeToContent="WidthAndHeight" Topmost="True"
        MouseDown="Window_MouseDown">
    <Border CornerRadius="8" BorderBrush="#888" BorderThickness="2" Padding="18" Background="#FF222222">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Width="420">
            <TextBlock x:Name="DetailText" Foreground="White" FontSize="15" TextWrapping="Wrap"/>
        </ScrollViewer>
    </Border>
</Window>
