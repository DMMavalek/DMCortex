<UserControl x:Class="DungeonMasterCortex.Views.OptionsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="28,16">
        <StackPanel>
            <TextBlock Text="OPTIONS" Style="{StaticResource TitleText}" FontSize="22" Margin="0,0,0,16"/>

            <!-- Activation Status -->
            <Border Background="#222" Padding="8" CornerRadius="6" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ActivationStatusText" FontWeight="Bold" Foreground="#FFD700" FontSize="15"/>
                    <TextBlock x:Name="ActivationHelpText" Foreground="#D8D8D8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBox x:Name="ActivationCodeTextBox"
                             Margin="0,8,0,0"
                             MinWidth="420"
                             ToolTip="Paste the activation response code here"/>
                    <Button Content="Release Notes"
                            Style="{StaticResource GoldButton}"
                            Width="160"
                            Margin="0,8,0,0"
                            Click="BtnReleaseNotes_Click"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Check for Updates" Style="{StaticResource GoldButton}" Width="160" Margin="0,0,10,0" Click="BtnCheckUpdates_Click"/>
                        <Button x:Name="BtnRequestActivation"
                            Content="Request Activation"
                                Style="{StaticResource GoldButton}"
                                Width="160"
                            Margin="0,0,10,0"
                            Click="BtnRequestActivation_Click"/>
                        <Button x:Name="BtnApplyActivation"
                            Content="Apply Code"
                            Style="{StaticResource GoldButton}"
                            Width="130"
                            Click="BtnApplyActivationCode_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <CheckBox x:Name="FullScreenCheckBox" Content="Enable Full Screen Mode" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Text Size:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TextSizeComboBox" Width="120">
                    <ComboBoxItem Content="Small"/>
                    <ComboBoxItem Content="Normal"/>
                    <ComboBoxItem Content="Large"/>
                    <ComboBoxItem Content="Extra Large"/>
                </ComboBox>
            </StackPanel>
            <CheckBox x:Name="AutoResizeCheckBox" Content="Auto-resize window to match font size" Margin="0,0,0,8"/>
            <CheckBox x:Name="StartupUpdateCheckBox" Content="Check for updates automatically on startup" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Content="APPLY" Style="{StaticResource GoldButton}" Width="120" Margin="0,0,10,0" Click="BtnApply_Click"/>
                <Button Content="BACK TO HUB" Style="{StaticResource GoldButton}" Width="140" Click="BtnBackToHub_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
