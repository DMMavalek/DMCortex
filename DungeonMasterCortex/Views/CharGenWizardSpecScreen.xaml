<UserControl x:Class="DungeonMasterCortex.Views.CharGenWizardSpecScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MaxHeight="320"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top row: specialization list + summary panel -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: specialization picker -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="WIZARD SPECIALIZATION" Style="{StaticResource TitleText}"
                           FontSize="20" Margin="0,0,0,4"/>
                <TextBlock Text="Choose mage or specialist school"
                           Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

                <TextBlock Text="Specialization" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ListBox x:Name="SpecList" Style="{StaticResource DarkListBox}"
                         ItemContainerStyle="{StaticResource DarkListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="SpecList_SelectionChanged"
                         Height="170"/>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                       VerticalAlignment="Stretch" Margin="0,20"/>

            <!-- Right: CP summary + info -->
            <StackPanel Grid.Column="2" Margin="20,0,0,0">
                <TextBlock Text="CP Budget" Style="{StaticResource TitleText}"
                           FontSize="20" Margin="0,0,0,4"/>
                <TextBlock Text="Remaining CP for additional class abilities"
                           Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

                <Border Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="16" Height="88" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Remaining CP" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BudgetSummary" Text="-"
                                   Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4"/>
                        <TextBlock x:Name="BudgetDetail" Text="Select a specialization"
                                   Style="{StaticResource BodyText}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="SpecTitle" Text="Select a specialization..."
                                   Style="{StaticResource TitleText}" FontSize="16" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SpecReqs" Text=""
                                   Style="{StaticResource LabelText}" FontSize="12" Margin="0,0,0,4"/>
                        <TextBlock x:Name="SpecOpp" Text=""
                                   Style="{StaticResource BodyText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom: auto-selected abilities -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Auto-Granted Specialization Abilities"
                           Style="{StaticResource LabelText}"/>
                <ListBox Grid.Row="2"
                         x:Name="AutoGrantedList"
                         DisplayMemberPath="Label"
                         Style="{StaticResource DarkListBox}"
                         ItemContainerStyle="{StaticResource DarkListBoxItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
