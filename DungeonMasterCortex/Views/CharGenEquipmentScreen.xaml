<UserControl x:Class="DungeonMasterCortex.Views.CharGenEquipmentScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="EQUIPMENT" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4"/>
            <TextBlock Text="Choose starting gear by category. Double-click is enabled for quick add/remove."
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,10"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Selected items" Style="{StaticResource SubtitleText}" FontSize="10"/>
                    <TextBlock x:Name="SelectedCountText" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}" Margin="0,2"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Import notes" Style="{StaticResource SubtitleText}" FontSize="10"/>
                    <TextBlock x:Name="ImportStatusText" Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Available equipment" Style="{StaticResource SubtitleText}"/>

                    <ComboBox Grid.Row="1" x:Name="CategoryFilter" Margin="0,8,0,0"
                              SelectionChanged="CategoryFilter_SelectionChanged"/>

                    <TextBox Grid.Row="2" x:Name="EquipmentSearchBox" Style="{StaticResource DarkTextBox}"
                             Margin="0,8,0,0" TextChanged="EquipmentSearchBox_TextChanged"/>

                    <ListBox Grid.Row="4" x:Name="AvailableList"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="AvailableList_MouseDoubleClick"
                             MouseRightButtonUp="AvailableList_MouseRightButtonUp"
                             SelectionChanged="AvailableList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" ToolTip="{Binding Description}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CostText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="BtnAdd" Content="ADD  ▶" Style="{StaticResource GoldButton}"
                        Margin="0,0,0,10" Click="BtnAdd_Click"/>
                <Button x:Name="BtnEquip" Content="⚔ EQUIP" Style="{StaticResource GoldButton}"
                        Margin="0,0,0,10" Click="BtnEquip_Click" IsEnabled="False"/>
                <Button x:Name="BtnRemove" Content="◀  REMOVE" Style="{StaticResource DarkButton}"
                        Margin="0,0,0,10" Click="BtnRemove_Click"/>
                <Button x:Name="BtnClear" Content="CLEAR" Style="{StaticResource DarkButton}"
                        Click="BtnClear_Click"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Selected equipment" Style="{StaticResource SubtitleText}"/>

                    <!-- Equipped slots summary -->
                    <Border Grid.Row="1" Background="{StaticResource BrushPanel}"
                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                            CornerRadius="2" Padding="8,6" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="EQUIPPED" Style="{StaticResource SubtitleText}" FontSize="9" Margin="0,0,0,4"/>
                            <TextBlock x:Name="EquippedArmorText" Style="{StaticResource BodyText}" FontSize="10"
                                       Text="Armor: —" TextWrapping="Wrap"/>
                            <TextBlock x:Name="EquippedShieldText" Style="{StaticResource BodyText}" FontSize="10"
                                       Text="Shield: —" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock x:Name="EquippedWeaponText" Style="{StaticResource BodyText}" FontSize="10"
                                       Text="Weapon: —" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="3" x:Name="SelectedList"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="SelectedList_MouseDoubleClick"
                             MouseRightButtonUp="SelectedList_MouseRightButtonUp"
                             SelectionChanged="SelectedList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SlotIcon}"
                                               Foreground="#E8C050" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" ToolTip="{Binding Description}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Style="{StaticResource SubtitleText}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CostText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>