<UserControl x:Class="DungeonMasterCortex.Views.CharGenEquipmentScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="0"/>
                <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="EQUIPMENT" Style="{StaticResource TitleText}" FontSize="20" Margin="0,0,0,4"/>
            <TextBlock Text="Choose starting gear by category. Double-click is enabled for quick add/remove."
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
            <TextBlock x:Name="CurrentMoneyText" Style="{StaticResource BodyText}" Margin="0,0,0,10" Visibility="Collapsed"/>
            <TextBlock x:Name="TransactionStatusText" Style="{StaticResource BodyText}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock Text="IMPORTANT NOTES" Style="{StaticResource SubtitleText}" FontSize="10" Margin="0,0,0,2" Visibility="Collapsed"/>
            <TextBlock x:Name="ImportStatusText" Style="{StaticResource BodyText}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,10"/>
        </StackPanel>

        <Border Grid.Row="2"
                Visibility="Collapsed"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Funds" Style="{StaticResource SubtitleText}" FontSize="10"/>
                    <TextBlock x:Name="StartingFundsText" Style="{StaticResource BodyText}" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="EquipmentSpendText" Style="{StaticResource BodyText}" Margin="0,2,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="RemainingFundsText" Style="{StaticResource BodyText}" Margin="0,2,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}" Margin="0,2"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Notes" Style="{StaticResource SubtitleText}" FontSize="10"/>
                    <TextBlock Text="Gems are shown in Selected equipment with [G]." Style="{StaticResource BodyText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Available equipment" Style="{StaticResource SubtitleText}"/>

                    <ComboBox Grid.Row="1" x:Name="CategoryFilter" Margin="0,8,0,0"
                              SelectionChanged="CategoryFilter_SelectionChanged"/>

                    <TextBox Grid.Row="2" x:Name="EquipmentSearchBox" Style="{StaticResource DarkTextBox}"
                             Margin="0,8,0,0" TextChanged="EquipmentSearchBox_TextChanged"/>

                    <ListBox Grid.Row="4" x:Name="AvailableList"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="AvailableList_MouseDoubleClick"
                             MouseRightButtonUp="AvailableList_MouseRightButtonUp"
                             SelectionChanged="AvailableList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" ToolTip="{Binding Description}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CostText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <Button x:Name="BtnAdd" Content="ADD  ▶" Style="{StaticResource GoldButton}"
                        Margin="0,0,0,10" Click="BtnAdd_Click"/>
                <Button x:Name="BtnEquip" Content="⚔ EQUIP" Style="{StaticResource GoldButton}"
                        Margin="0,0,0,10" Click="BtnEquip_Click" IsEnabled="False"/>
                <Button x:Name="BtnSetQuantity" Content="SET QTY" Style="{StaticResource GoldButton}"
                    Margin="0,0,0,10" Click="BtnSetQuantity_Click" IsEnabled="False"/>
                <Button x:Name="BtnAddFunds" Content="ADD FUNDS" Style="{StaticResource GoldButton}"
                    Margin="0,0,0,10" Click="BtnAddFunds_Click"/>
                <Button x:Name="BtnRemove" Content="◀  REMOVE" Style="{StaticResource DarkButton}"
                        Margin="0,0,0,10" Click="BtnRemove_Click"/>
                <Button x:Name="BtnClear" Content="CLEAR" Style="{StaticResource DarkButton}"
                        Click="BtnClear_Click"/>
            </StackPanel>

            <Border Grid.Column="2" Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1"
                    CornerRadius="2" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Selected equipment" Style="{StaticResource SubtitleText}"/>

                    <!-- Equipped slots summary -->
                    <Expander Grid.Row="1" x:Name="EquippedExpander" IsExpanded="True" Margin="0,8,0,0"
                              Loaded="EquippedExpander_Loaded"
                              Expanded="EquippedExpander_Expanded"
                              Collapsed="EquippedExpander_Collapsed"
                              Background="{StaticResource BrushPanel}">
                        <Expander.Header>
                            <TextBlock Text="EQUIPPED" Style="{StaticResource SubtitleText}" FontSize="9"/>
                        </Expander.Header>
                        <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock x:Name="EquippedArmorText" Style="{StaticResource BodyText}" FontSize="10"
                                           Text="Armor: —" TextWrapping="Wrap"/>
                                <TextBlock x:Name="EquippedShieldText" Style="{StaticResource BodyText}" FontSize="10"
                                           Text="Shield: —" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                <TextBlock x:Name="EquippedWeaponText" Style="{StaticResource BodyText}" FontSize="10"
                                           Text="Weapon: —" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <ListBox Grid.Row="3" x:Name="SelectedList"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="SelectedList_MouseDoubleClick"
                             MouseRightButtonUp="SelectedList_MouseRightButtonUp"
                             SelectionChanged="SelectedList_SelectionChanged">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True" Margin="0,2,0,4"
                                                              Tag="{Binding Name}"
                                                              Loaded="SelectedGroupExpander_Loaded"
                                                              Expanded="SelectedGroupExpander_Expanded"
                                                              Collapsed="SelectedGroupExpander_Collapsed">
                                                        <Expander.Header>
                                                            <DockPanel LastChildFill="False">
                                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SubtitleText}"/>
                                                                <TextBlock Text="{Binding ItemCount, StringFormat= ({0})}" Style="{StaticResource BodyText}" Margin="6,0,0,0"/>
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <ItemsPresenter Margin="0,4,0,0"/>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SlotIcon}"
                                               Foreground="#E8C050" FontSize="10"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource BodyText}" TextWrapping="NoWrap" ToolTip="{Binding Description}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding QuantityText}" Style="{StaticResource SubtitleText}" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CostText}" Style="{StaticResource SubtitleText}" Foreground="{StaticResource BrushDim}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>