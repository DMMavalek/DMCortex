<UserControl x:Class="DungeonMasterCortex.Views.DiceRollerScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="DICE ROLLER"
                       Style="{StaticResource TitleText}" FontSize="20"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="TOOLKIT" Style="{StaticResource GoldButton}"
                Width="108" FontSize="12" Margin="0,0,8,0" Click="BtnToolkit_Click"/>
            <Button Content="CHARACTERS" Style="{StaticResource GoldButton}"
                Width="108" FontSize="12" Click="BtnCharacters_Click"/>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="1" Height="1" Fill="{StaticResource BrushBorder}" Margin="0,10,0,12"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Character Type" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <StackPanel Margin="0,0,0,10">
                    <RadioButton x:Name="RbCoreRules" Content="Core Rules character"
                                 Style="{StaticResource DarkRadio}" Checked="RulesetRadio_Checked"/>
                    <RadioButton x:Name="RbPlayersOption" Content="Player's Option character"
                                 Style="{StaticResource DarkRadio}" Checked="RulesetRadio_Checked"/>
                </StackPanel>

                <TextBlock Text="Method Source: PHB + Skills &amp; Powers"
                           Style="{StaticResource SubtitleText}" FontSize="10"
                           Margin="0,0,0,8"/>
                <TextBlock Text="Rolling Method" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbMethod" SelectedIndex="0" SelectionChanged="CmbMethod_SelectionChanged"
                          Margin="0,0,0,10" Padding="6,4" FontSize="12" MinWidth="320"
                          Background="{StaticResource BrushInputBg}" Foreground="{StaticResource BrushText}"
                          BorderBrush="{StaticResource BrushBorder2}"/>

                <TextBlock x:Name="MethodDesc" Style="{StaticResource SubtitleText}"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Button Content="ROLL ABILITIES" Style="{StaticResource GoldButton}"
                    FontSize="12" Click="BtnRoll_Click" Margin="0,0,0,8"/>
                <Button Content="RESET" Style="{StaticResource GoldButton}"
                    FontSize="12" Click="BtnClear_Click" Width="120"/>

                <Border Style="{StaticResource GoldCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource SubtitleText}"
                           FontSize="10"
                           Text="Manual Entry uses the small text boxes beside each ability. Drag-and-drop remains available for rolled methods."/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}" VerticalAlignment="Stretch"/>

            <Grid Grid.Column="2" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dice Pool" Style="{StaticResource LabelText}" FontSize="11"/>

                <Border Grid.Row="1" Margin="0,6,0,0" Padding="8"
                        Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="4"
                        AllowDrop="True" DragOver="DropTarget_DragOver" Drop="PoolDrop_Drop">
                    <ItemsControl x:Name="PoolItems">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="4"
                                        PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="Token_PreviewMouseMove"
                                        Cursor="Hand">
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Grid.Row="2" Text="Drag dice onto abilities"
                           Style="{StaticResource SubtitleText}" FontSize="10" Margin="0,10,0,6"/>

                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108"/>
                        <ColumnDefinition x:Name="SlotColumn" Width="136"/>
                        <ColumnDefinition x:Name="ManualEntryColumn" Width="78"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Strength" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotStr" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="str"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsStr" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValStr" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtStrManual" Grid.Row="0" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>

                    <TextBlock Grid.Row="1" Text="Dexterity" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotDex" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="dex"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsDex" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValDex" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtDexManual" Grid.Row="1" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>

                    <TextBlock Grid.Row="2" Text="Constitution" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotCon" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="con"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsCon" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValCon" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtConManual" Grid.Row="2" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>

                    <TextBlock Grid.Row="3" Text="Intelligence" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotInt" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="int"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsInt" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValInt" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtIntManual" Grid.Row="3" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>

                    <TextBlock Grid.Row="4" Text="Wisdom" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotWis" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="wis"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsWis" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValWis" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtWisManual" Grid.Row="4" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>

                    <TextBlock Grid.Row="5" Text="Charisma" Style="{StaticResource LabelText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="SlotCha" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Padding="10,6"
                            Background="{StaticResource BrushInputBg}" BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="4" Tag="cha"
                            AllowDrop="True" DragOver="DropTarget_DragOver" Drop="AbilityDrop_Drop">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ItemsControl x:Name="ItemsCha" Grid.Column="0" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushBtn}" BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="2"
                                                PreviewMouseLeftButtonDown="Token_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Token_PreviewMouseMove"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource LabelText}" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ValCha" Grid.Column="1" Style="{StaticResource LabelText}" FontSize="11"
                                       Text="Drop die" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="TxtChaManual" Grid.Row="5" Grid.Column="2" Margin="8,0,0,8"
                             Style="{StaticResource DarkTextBox}" FontSize="11" Text=""/>
                </Grid>

                <Border Grid.Row="4" Background="{StaticResource BrushCard}" BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" Style="{StaticResource SubtitleText}" TextWrapping="Wrap"
                               Text="Choose a method, roll, then drag dice onto abilities."/>
                </Border>
            </Grid>
        </Grid>

        <!-- Navigation footer -->
        <Grid Grid.Row="3" Margin="0,14,0,4">
            <Button HorizontalAlignment="Right" Content="NEXT  ▶"
                    Style="{StaticResource GoldButton}" Width="130" Click="BtnUse_Click"/>
        </Grid>
    </Grid>
</UserControl>
