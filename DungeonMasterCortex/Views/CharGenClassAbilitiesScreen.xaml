<UserControl x:Class="DungeonMasterCortex.Views.CharGenClassAbilitiesScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="40,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto" MinHeight="320"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header bar — title/tabs left, budget right -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="CLASS ABILITY ASSIGNMENT" Style="{StaticResource TitleText}"
                           FontSize="20" Margin="0,0,0,4"/>
                <TextBlock x:Name="SubtitleLabel"
                           Text="Step 6  &#xB7;  Allocate class ability CP"
                           Style="{StaticResource SubtitleText}" Margin="0,0,0,10"/>
                <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,10"/>

                <!-- Multi-class tab buttons (hidden for single-class) -->
                <StackPanel x:Name="MultiClassTabPanel" Visibility="Collapsed" Margin="0,0,0,6">
                    <TextBlock Text="Select class to configure:" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="MultiClassClassTabs"/>
                </StackPanel>

                <!-- Active class name line -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ClassTitle" Grid.Column="0" Text=""
                               Style="{StaticResource TitleText}" FontSize="16"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="ClassInfo" Grid.Column="1" Text=""
                               Style="{StaticResource BodyText}" FontSize="11"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{StaticResource BrushBorder2}"/>
                </Grid>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                       VerticalAlignment="Stretch" Margin="0,4"/>

            <!-- Budget card -->
            <Border Grid.Column="2" Margin="16,0,0,0"
                    Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder2}"
                    BorderThickness="1" CornerRadius="2" Padding="14,10"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Remaining CP" Style="{StaticResource SubtitleText}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="ClassBudgetSummary" Text="-"
                               Style="{StaticResource TitleText}" FontSize="26" Margin="0,0,0,2"/>
                    <TextBlock x:Name="ClassBudgetDetail" Text=""
                               Style="{StaticResource BodyText}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 2: Class Configuration (Wizard / Priest / Druid) — full width, shown only when relevant -->
        <Border x:Name="ClassConfigCard" Grid.Row="2" Visibility="Collapsed"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Config description -->
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ClassConfigTitle" Text="Class Configuration"
                               Style="{StaticResource LabelText}" FontSize="13" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ClassConfigHint" Text=""
                               Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               FontSize="12" Margin="0,0,0,6"/>
                    <!-- Specialization display (wizard) -->
                    <TextBlock x:Name="ClassConfigSpecLabel" Text=""
                               Style="{StaticResource SubtitleText}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Config action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSelectSpheres" Visibility="Collapsed"
                            Content="Configure Priest Spheres..."
                            Click="BtnSelectSpheres_Click"
                            Padding="14,8" Height="36"
                            Style="{StaticResource GoldButton}"/>
                    <Button x:Name="BtnSelectWizardSchools" Visibility="Collapsed"
                            Content="Configure Wizard Schools &amp; Specialty..."
                            Click="BtnSelectWizardSchools_Click"
                            Padding="14,8" Height="36" Margin="8,0,0,0"
                            Style="{StaticResource GoldButton}"/>
                    <Button x:Name="BtnAllocateRogueSkills" Visibility="Collapsed"
                        Content="Allocate Rogue Skills..."
                        Click="BtnAllocateRogueSkills_Click"
                        Padding="14,8" Height="36" Margin="8,0,0,0"
                        Style="{StaticResource GoldButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Sphere / School summary bar -->
        <Border x:Name="SphereSchoolSection" Grid.Row="4" Visibility="Collapsed"
                Background="#1A1610"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SphereSchoolSectionLabel" Grid.Column="0"
                           Text="" Style="{StaticResource SubtitleText}"
                           FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource BrushLightGold}"/>
                <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                           VerticalAlignment="Stretch" Margin="0,2"/>
                <TextBlock x:Name="SphereSchoolSectionSummary" Grid.Column="2"
                           Text="" Style="{StaticResource BodyText}"
                           FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource BrushLightGold}"/>
            </Grid>
        </Border>

        <!-- Row 6: Ability selection panel -->
        <Border Grid.Row="6"
                Background="{StaticResource BrushCard}"
                BorderBrush="{StaticResource BrushBorder2}"
                BorderThickness="1" CornerRadius="2" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Class Ability Selection" Style="{StaticResource LabelText}"/>
                <TextBlock Grid.Row="2" x:Name="ClassAbilityHint"
                           Text="Double-click or use the arrows to add/remove optional abilities."
                           Style="{StaticResource SubtitleText}" TextWrapping="Wrap"/>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal">
                        <Button x:Name="BtnAbilitiesTab"
                                Content="Abilities"
                                Style="{StaticResource GoldButton}"
                                Height="32"
                                Width="120"
                                Margin="0,0,8,0"
                                Click="BtnAbilitiesTab_Click"/>
                        <Button x:Name="BtnDisadvantagesTab"
                                Content="Disadvantages"
                                Style="{StaticResource DarkButton}"
                                Height="32"
                                Width="140"
                                Click="BtnDisadvantagesTab_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Grid.Column="0"
                            Background="{StaticResource BrushPanel}"
                            BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="2" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="AvailableListTitle" Text="Available Abilities" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Grid.Row="1" x:Name="AvailableClassAbilitySummary"
                                       Text="0 optional abilities available"
                                       Style="{StaticResource BodyText}" FontSize="11" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="3" x:Name="AvailableClassAbilityList"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     MinHeight="240"
                                     MaxHeight="420"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="AvailableClassAbilityList_MouseDoubleClick"
                                     MouseRightButtonUp="AvailableClassAbilityList_MouseRightButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                        <Button x:Name="BtnAddClassAbility" Content="&#x276F;"
                                Style="{StaticResource GoldButton}" Height="36" Margin="0,0,0,8"
                                Click="BtnAddClassAbility_Click"/>
                        <Button x:Name="BtnRemoveClassAbility" Content="&#x276E;"
                                Style="{StaticResource GoldButton}" Height="36"
                                Click="BtnRemoveClassAbility_Click"/>
                    </StackPanel>

                        <Border Grid.Row="2" Grid.Column="2"
                            Background="{StaticResource BrushPanel}"
                            BorderBrush="{StaticResource BrushBorder2}"
                            BorderThickness="1" CornerRadius="2" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" x:Name="SelectedListTitle" Text="Current Class Package" Style="{StaticResource SubtitleText}"/>
                            <TextBlock Grid.Row="1" x:Name="SelectedClassAbilitySummary"
                                       Text="0 abilities selected"
                                       Style="{StaticResource BodyText}" FontSize="11" TextWrapping="Wrap"/>
                            <ListBox Grid.Row="3" x:Name="SelectedClassAbilityList"
                                     Style="{StaticResource DarkListBox}"
                                     ItemContainerStyle="{StaticResource DarkListBoxItem}"
                                     MinHeight="240"
                                     MaxHeight="420"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     MouseDoubleClick="SelectedClassAbilityList_MouseDoubleClick"
                                     MouseRightButtonUp="SelectedClassAbilityList_MouseRightButtonUp">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
