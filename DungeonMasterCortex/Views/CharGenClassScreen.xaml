<UserControl x:Class="DungeonMasterCortex.Views.CharGenClassScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid Margin="40,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Class selection -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="CHOOSE YOUR CLASS" Style="{StaticResource TitleText}"
                       FontSize="20" Margin="0,0,0,4"/>
            <TextBlock x:Name="ClassScreenSubtitle"
                       Text="Step 5  ·  Select class"
                       Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

            <!-- Class Mode Selector -->
            <TextBlock Text="Class Mode" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="RadioSingleClass" Content="Single Class" Margin="0,0,16,0"
                             IsChecked="True" Checked="ClassMode_Changed"
                             Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioMultiClass" Content="Multi-Class" Margin="0,0,16,0"
                             Checked="ClassMode_Changed"
                             Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
                <RadioButton x:Name="RadioDualClass" Content="Dual-Class"
                             Checked="ClassMode_Changed"
                             Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Single Class Mode -->
            <StackPanel x:Name="SingleClassPanel" Visibility="Visible">
                <TextBlock x:Name="SingleClassLabel" Text="Classes available for your race:"
                           Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <ListBox x:Name="ClassList" Style="{StaticResource DarkListBox}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ClassList_SelectionChanged"
                         MouseRightButtonUp="ClassList_MouseRightButtonUp"
                         Height="220">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DarkListBoxItem}">
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" ToolTip="{Binding AvailabilityHint}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Foreground" Value="#C05050"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Multi-Class Mode -->
            <StackPanel x:Name="MultiClassPanel" Visibility="Collapsed">
                <TextBlock x:Name="MultiClassLabel" Text="Classes available for your race (check 2+):"
                           Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource BrushPanel}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="10" Height="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="MultiClassCheckList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" Margin="0,5"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEnabled}"
                                              Checked="MultiClassCheckbox_Changed"
                                              Unchecked="MultiClassCheckbox_Changed"
                                              MouseEnter="MultiClassCheckbox_MouseEnter"
                                              Tag="{Binding Id}">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                        <Setter Property="Foreground" Value="#C05050"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <TextBlock x:Name="MultiClassValidation" Text="" FontSize="11"
                           Foreground="{StaticResource BrushTitle}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="ValidationLabel" Text=""
                       TextWrapping="Wrap" Margin="0,10,0,0"
                       FontFamily="Georgia" FontSize="12"/>

        </StackPanel>

        <!-- Divider -->
        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushBorder2}"
                   VerticalAlignment="Stretch" Margin="0,20"/>

        <!-- RIGHT: Class details -->
        <ScrollViewer Grid.Column="2" Margin="20,0,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="CLASS DETAILS" Style="{StaticResource TitleText}"
                           FontSize="20" Margin="0,0,0,4"/>
                <TextBlock x:Name="ClassDetailSubtitle"
                           Text="Select a class to see details"
                           Style="{StaticResource SubtitleText}" Margin="0,0,0,16"/>
                <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>

                <!-- Name + CP budget badge -->
                <Border Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ClassTitle" Grid.Column="0"
                                       Text="&#x2014;"
                                       Style="{StaticResource TitleText}" FontSize="18"
                                       VerticalAlignment="Center"/>
                            <Border x:Name="ClassCpBadge" Grid.Column="1"
                                    Visibility="Collapsed"
                                    Background="#2A2010"
                                    BorderBrush="{StaticResource BrushBorder2}"
                                    BorderThickness="1" CornerRadius="10" Padding="8,3"
                                    VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="ClassCpBadgeText" Text=""
                                           Foreground="{StaticResource BrushLightGold}"
                                           FontFamily="Georgia" FontSize="11"/>
                            </Border>
                        </Grid>

                        <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,10,0,10"/>

                        <!-- Ability requirements with pass/fail indicators -->
                        <TextBlock Text="ABILITY REQUIREMENTS"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="10" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ClassRequirementsPanel">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="18"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding AbilityName}"
                                                   Style="{StaticResource BodyText}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Required}"
                                                   Style="{StaticResource BodyText}" FontSize="12"
                                                   Foreground="{StaticResource BrushBorder2}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="&#x25B8;"
                                                   Foreground="{StaticResource BrushBorder2}"
                                                   FontSize="10" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Actual}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding StatusColor}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StatusGlyph}"
                                                   Foreground="{Binding StatusColor}"
                                                   FontSize="12" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ClassNoRequirements" Text="No special requirements"
                                   Style="{StaticResource BodyText}" FontSize="11"
                                   Foreground="{StaticResource BrushBorder2}" Margin="0,2"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Auto-granted abilities preview -->
                <Border x:Name="ClassAutoAbilitiesCard"
                        Visibility="Collapsed"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="AUTO-GRANTED ABILITIES"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="10" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="ClassAutoAbilitiesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}"
                                               FontSize="11" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Optional abilities count -->
                <Border x:Name="ClassOptionalAbilitiesCard"
                        Visibility="Collapsed"
                        Background="{StaticResource BrushCard}"
                        BorderBrush="{StaticResource BrushBorder2}"
                        BorderThickness="1" CornerRadius="2" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="OPTIONAL ABILITIES"
                                   Style="{StaticResource SubtitleText}"
                                   FontSize="10" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ClassOptionalAbilitiesText" Text=""
                                   Style="{StaticResource BodyText}" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Hidden compat field for right-click message box -->
                <TextBlock x:Name="ClassInfo" Text="" Visibility="Collapsed"/>

                <!-- Kit Selection (shown only when race has kits available) -->
                <StackPanel x:Name="KitPanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,12"/>
                    <TextBlock Text="CHOOSE A KIT (OPTIONAL)" Style="{StaticResource TitleText}"
                               FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock x:Name="KitSubtitle"
                               Text="Kits add flavor and special abilities to your character."
                               Style="{StaticResource SubtitleText}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ListBox x:Name="KitList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="KitList_SelectionChanged"/>
                    <TextBlock x:Name="KitDescriptionText" Text=""
                               Style="{StaticResource BodyText}" FontSize="11"
                               TextWrapping="Wrap" Margin="0,8,0,0" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
