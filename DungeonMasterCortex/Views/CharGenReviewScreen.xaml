<UserControl x:Class="DungeonMasterCortex.Views.CharGenReviewScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" MaxWidth="720" Margin="40,20">

            <TextBlock Text="CHARACTER SUMMARY"
                       Style="{StaticResource TitleText}" FontSize="22"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Review and finalise your character"
                       Style="{StaticResource SubtitleText}"
                       HorizontalAlignment="Center" Margin="0,4,0,16"/>
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,20"/>

            <!-- Summary card -->
            <Border Background="{StaticResource BrushCard}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="2" Padding="32,24">
                <StackPanel>
                    <!-- Name / Race / Class -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:"
                                   Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="SumName"
                                 Style="{StaticResource DarkTextBox}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Race:"
                                   Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SumRace"
                                   Style="{StaticResource BodyText}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Class:"
                                   Style="{StaticResource LabelText}" Margin="0,4"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SumClass"
                                   Style="{StaticResource BodyText}" Margin="0,4"/>
                    </Grid>

                    <Border Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder2}" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,4,0,8">
                        <StackPanel>
                            <TextBlock Text="Core Combat Stats" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Level:" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="LevelInput" Style="{StaticResource DarkTextBox}" Margin="0,0,12,0" TextChanged="LevelInput_TextChanged"/>
                                <CheckBox Grid.Column="2" x:Name="MaxHpAtLevelOneCheck" Content="Use max HP at level 1" IsChecked="True" Checked="MaxHpAtLevelOneCheck_Changed" Unchecked="MaxHpAtLevelOneCheck_Changed" Foreground="{StaticResource BrushText}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid x:Name="CpPerLevelRow" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CP / Level:" Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="CpPerLevelInput" Style="{StaticResource DarkTextBox}" Text="0" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="2" Text="Auto-awarded each level-up (0 = ask)" Style="{StaticResource SubtitleText}" VerticalAlignment="Center" Foreground="{StaticResource BrushDim}"/>
                            </Grid>
                            <TextBlock x:Name="LevelUpSummary" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                       Foreground="#E8C050" Margin="0,4,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="CoreStatsSummary" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1" Fill="{StaticResource BrushBorder2}" Margin="0,12"/>

                    <!-- Ability score row -->
                    <ItemsControl x:Name="SumAbilities">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBtn}"
                                        BorderBrush="{StaticResource BrushBorder2}"
                                        BorderThickness="1" CornerRadius="2"
                                        Width="82" Height="82" Margin="5,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score}"
                                                   FontFamily="Georgia" FontSize="24" FontWeight="Bold"
                                                   Foreground="{Binding ScoreColor}"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Abbrev}"
                                                   Style="{StaticResource SubtitleText}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="{StaticResource BrushBorder2}" Margin="0,12"/>

                    <TextBlock x:Name="CpSummary" Text=""
                               Style="{StaticResource LabelText}" Margin="0,0,0,8"/>

                    <TextBlock Text="Racial Abilities" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="SumRacialAbilities">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Rectangle Height="1" Fill="{StaticResource BrushBorder2}" Margin="0,12"/>

                    <TextBlock x:Name="ClassCpSummary" Text=""
                               Style="{StaticResource LabelText}" Margin="0,0,0,8"/>

                    <TextBlock Text="Class Abilities" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="SumClassAbilities">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Character Options" Style="{StaticResource LabelText}" Margin="0,10,0,6"/>
                    <ItemsControl x:Name="SumCharacterOptions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="SpellcastingSummaryHeader"
                               Text="Spellcasting Selections"
                               Style="{StaticResource LabelText}"
                               Margin="0,10,0,6"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="SpellcastingSummary"
                               Style="{StaticResource BodyText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,2"
                               Visibility="Collapsed"/>

                    <Rectangle Height="1" Fill="{StaticResource BrushBorder2}" Margin="0,12"/>

                    <TextBlock Text="Sub-Ability Mechanics" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="SumSubAbilityBreakdown">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding LineColor}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Derived Totals" Style="{StaticResource LabelText}" Margin="0,10,0,6"/>
                    <ItemsControl x:Name="SumSubDerivedTotals">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding LineColor}"
                                           Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,20,0,16"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnCharacterSheets" Content="CHARACTER SHEETS"
                    Style="{StaticResource GoldButton}" Width="220" Margin="0,0,10,0"
                    Click="BtnCharacterSheets_Click"/>
                <Button x:Name="BtnFinalise" Content="✔  FINALISE CHARACTER"
                    Style="{StaticResource GoldButton}" Width="260"
                    HorizontalAlignment="Center" Click="BtnFinalise_Click"/>
                </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
