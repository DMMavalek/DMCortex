<UserControl x:Class="DungeonMasterCortex.Views.HubScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BrushPanel}">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="800">

            <!-- Ornament bar -->
            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
                <Ellipse Width="12" Height="12" Fill="{StaticResource BrushTitle}" Margin="6,0"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
            </StackPanel>

            <TextBlock x:Name="TxtHubTitle" Text="AD&amp;D 2nd Edition Toolkit"
                       Style="{StaticResource TitleText}" FontSize="26"
                       HorizontalAlignment="Center" Margin="0,8,0,4"/>
            <TextBlock Text="Select a tool to begin your adventure"
                       Style="{StaticResource SubtitleText}" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,0,0,28"/>

            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Padding="12,8" Margin="0,0,0,18" CornerRadius="6">
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtActivationStatus"
                                   Style="{StaticResource SubtitleText}"
                                   VerticalAlignment="Center"
                                   Text="Demo mode active"/>
                        <TextBlock x:Name="TxtAppVersion"
                                   Style="{StaticResource SubtitleText}"
                                   VerticalAlignment="Center"
                                   Margin="0,2,0,0"
                                   Text="Version 1.1.00"/>
                    </StackPanel>
                    <Button x:Name="BtnOptions"
                            Content="OPTIONS"
                            DockPanel.Dock="Right"
                            Style="{StaticResource GoldButton}"
                            Margin="12,0,0,0"
                            Padding="12,4"
                            Click="BtnOptions_Click"/>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,0,0,28">
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
                <Ellipse Width="12" Height="12" Fill="{StaticResource BrushTitle}" Margin="6,0"/>
                <Ellipse Width="8" Height="8" Fill="{StaticResource BrushBorder}" Margin="6,0"/>
            </StackPanel>

            <!-- Hub cards -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,8">

                <!-- Session Manager -->
                <Border x:Name="CardSessions" Style="{StaticResource GoldCard}" Margin="16,0" Width="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="⌘" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTitle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="SESSION MANAGER"
                                   Style="{StaticResource TitleText}" FontSize="14"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" x:Name="TxtSessionCardDescription"
                                   Text="Host a table session or join one on your local network"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,16" VerticalAlignment="Top"/>
                        <Button Grid.Row="3" Content="OPEN" Style="{StaticResource GoldButton}"
                                x:Name="BtnSessions" Click="BtnSessions_Click"/>
                    </Grid>
                </Border>

                <!-- Character Blueprint -->
                <Border x:Name="CardDmTools" Style="{StaticResource GoldCard}" Margin="16,0" Width="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="⚔" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTitle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="CHARACTER BLUEPRINT"
                                   Style="{StaticResource TitleText}" FontSize="14"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Create and customise your adventurers"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,16" VerticalAlignment="Top"/>
                        <Button Grid.Row="3" Content="OPEN" Style="{StaticResource GoldButton}"
                                x:Name="BtnCharGen" Click="BtnCharGen_Click"/>
                    </Grid>
                </Border>

                <!-- DM Tools -->
                <Border x:Name="CardCampaign" Style="{StaticResource GoldCard}" Margin="16,0" Width="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="🗡" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTitle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="DM TOOLS"
                                   Style="{StaticResource TitleText}" FontSize="14"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Combat tracker and rules editor"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,16" VerticalAlignment="Top"/>
                        <Button Grid.Row="3" Content="OPEN" Style="{StaticResource GoldButton}"
                                x:Name="BtnDmTools" Click="BtnDmTools_Click"/>
                    </Grid>
                </Border>

                <!-- Campaign Tracking -->
                <Border x:Name="CardCampaignTracker" Style="{StaticResource GoldCard}" Margin="16,0" Width="220">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="📜" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource BrushTitle}" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Text="CAMPAIGN TRACKING"
                                   Style="{StaticResource TitleText}" FontSize="14"
                                   HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="2" Text="Manage NPCs, locations, and session notes"
                                   Style="{StaticResource SubtitleText}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,0,0,16" VerticalAlignment="Top"/>
                        <Button Grid.Row="3" Content="OPEN" Style="{StaticResource GoldButton}"
                                x:Name="BtnCampaign" Click="BtnCampaign_Click"/>
                    </Grid>
                </Border>

            </WrapPanel>

            <Rectangle Height="1" Fill="{StaticResource BrushBorder}" Margin="0,28,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
